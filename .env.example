# --- Copy this file to .env and fill in real values ---
# The app does NOT start if a required variable is missing.

# Signs the session cookies. Generate a new one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# Allowed origin of the frontend (CORS). The Vite dev server in development.
# Separate several with commas. Never "*" together with cookies.
CORS_ORIGINS=http://localhost:5173

# Sets the Secure flag on the cookie. false in development (http),
# true in production (https).
COOKIE_SECURE=false

# Path to the SQLite file, relative to the project root.
DATABASE_URL=sqlite+aiosqlite:///./data/dashboard.db

# Where the backend binds
HOST=127.0.0.1
PORT=8000

# No admin password in this file. Create a user with:
#   python backend/scripts/create_user.py
# It asks for the password interactively so it never sits anywhere in plain text.

# --- Server manager ---------------------------------------------------------

# NOT the bare socket. Whoever reaches /var/run/docker.sock is root on the host,
# bypassing whatever privileges the backend itself has. A socket proxy with a
# restricted endpoint set belongs in front of it (see docs/security.md).
DOCKER_HOST=tcp://127.0.0.1:2375
DOCKER_TIMEOUT=10

# Rhythm of the background sampler, in seconds. Docker needs about a second per
# container for a CPU delta — anything shorter buys nothing.
SERVERS_SAMPLE_SECONDS=10
# How many points the sparklines show.
SERVERS_HISTORY_LENGTH=40

# Mount points for the disk display. Empty: detect physical partitions. Worth
# pinning on macOS, where every APFS system volume shows up. Comma separated.
SERVERS_DISKS=

# Which containers may later be CONTROLLED (phase: write access). Empty means
# none — the list only ever grows deliberately. Reading is unaffected:
# everything is shown.
SERVERS_CONTROL_ALLOWLIST=
